**/build/
*.tsbuildinfo

# Test, E2E & coverage artifacts
coverage/
**/coverage/
.nyc_output/
e2e/
server/tests/
client/src/test/
**/*.test.*
**/*.spec.*
test-results/
playwright-report/
blob-report/
playwright/

# Local database volumes & data files
.pgdata/
.*pgdata*/
test-pgdata/
*.sqlite
*.sqlite3
*.db

# Git, CI, editor & OS metadata
.git/
.gitignore
.github/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*.log
