# QMS environment variables. Copy to server/.env (and server/.env.test for tests); never commit real values.
# The database URLs below are the local Docker Compose defaults (docker-compose.yml), not production credentials.

# HTTP listen port. Optional, default 3000. Cloud Run sets this itself.
PORT=3000
# Runtime mode: development, test or production. production serves client/dist and sets Secure cookies.
NODE_ENV=development
# PostgreSQL connection string for the app, migrations and seed. Required; no built-in default. Secret outside local dev.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qms_db?schema=public
# Separate database used only when NODE_ENV=test; tests delete all rows and refuse to run if it equals DATABASE_URL.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qms_test_db?schema=public
# Secret, at least 32 characters. The server refuses to start with this placeholder. Generate your own value.
SESSION_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARS
# Optional: comma-separated origins allowed to call the API cross-origin. Leave empty for same-origin only.
CORS_ORIGIN=
# Optional: commit SHA of the running build, shown by GET /api/health. Set by CI/deploy; leave empty locally.
COMMIT_SHA=
# Optional: fallback version label for GET /api/health when COMMIT_SHA is not set (otherwise "unknown").
APP_VERSION=
# Seed only: password for every seeded demo account. Optional when NODE_ENV is development or test
# (the public dev password is used). Required for any other database, e.g. Cloud SQL; set it in the
# shell, never in a committed file. At least 12 characters.
SEED_PASSWORD=
